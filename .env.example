# Demo mode works with no credentials. Set both to enable Gemini answers.
GOOGLE_API_KEY=
DATABASE_URL=postgresql://support:support@localhost:5432/support
GEMINI_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2

# Cosine similarity floor; tune against your own support questions (0 < score <= 1).
MIN_RETRIEVAL_SCORE=0.5

# Neon direct connection for schema setup (optional for local PostgreSQL).
DATABASE_URL_UNPOOLED=
# Deployed document writes are off unless explicitly enabled.
# ALLOW_DOCUMENT_WRITES=false
