{
  "name": "support-copilot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:setup": "node --env-file-if-exists=.env.local scripts/setup-db.mjs",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@langchain/google": "0.2.4",
    "@langchain/core": "1.2.9",
    "@langchain/textsplitters": "1.0.1",
    "@google/genai": "2.21.0",
    "pg": "8.23.0",
    "zod": "4.5.4",
    "lucide-react": "1.42.0",
    "server-only": "0.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "radix-ui": "1.6.7",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "@playwright/test": "1.63.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@11.22.0"
}
